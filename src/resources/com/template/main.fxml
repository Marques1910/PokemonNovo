<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane
        prefHeight="620.0"
        prefWidth="980.0"
        styleClass="app-root"
        stylesheets="@style.css"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.template.controller.MainController">

    <!-- CABEÇALHO -->
    <top>

        <HBox
                alignment="CENTER_LEFT"
                spacing="18.0"
                styleClass="app-header">

            <StackPane>

                <Circle
                        radius="25.0"
                        styleClass="pokedex-lens" />

                <Circle
                        radius="15.0"
                        styleClass="pokedex-lens-inner" />

            </StackPane>

            <VBox spacing="3.0">

                <Label
                        styleClass="app-title"
                        text="POKÉDEX" />

                <Label
                        styleClass="app-subtitle"
                        text="Gerenciamento de Pokémon" />

            </VBox>

        </HBox>

    </top>

    <!-- CONTEÚDO -->
    <center>

        <HBox
                alignment="TOP_CENTER"
                spacing="22.0"
                styleClass="content-area">

            <!-- FORMULÁRIO -->
            <VBox
                    prefWidth="320.0"
                    spacing="18.0"
                    styleClass="card">

                <HBox
                        alignment="CENTER_LEFT"
                        spacing="10.0">

                    <Label
                            styleClass="section-title"
                            text="Cadastro" />

                    <Region
                            HBox.hgrow="ALWAYS" />

                    <Label
                            fx:id="lblModo"
                            styleClass="mode-badge"
                            text="Novo cadastro" />

                </HBox>

                <GridPane
                        hgap="12.0"
                        vgap="14.0">

                    <Label
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"
                            styleClass="field-label"
                            text="Nome *" />

                    <TextField
                            fx:id="txtNome"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"
                            maxWidth="1.7976931348623157E308"
                            promptText="Ex: Pikachu" />

                    <Label
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"
                            styleClass="field-label"
                            text="Tipo *" />

                    <ComboBox
                            fx:id="cbTipo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"
                            editable="true"
                            maxWidth="1.7976931348623157E308"
                            promptText="Selecione o tipo" />

                    <Label
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"
                            styleClass="field-label"
                            text="Número *" />

                    <TextField
                            fx:id="txtNum"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"
                            maxWidth="1.7976931348623157E308"
                            promptText="Ex: 25" />

                    <Label
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"
                            styleClass="field-label"
                            text="Geração *" />

                    <Spinner
                            fx:id="spGeracao"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"
                            maxWidth="1.7976931348623157E308" />

                </GridPane>

                <Label
                        styleClass="required-hint"
                        text="* Campos obrigatórios" />

                <HBox spacing="10.0">

                    <Button
                            fx:id="btnAdicionar"
                            defaultButton="true"
                            HBox.hgrow="ALWAYS"
                            maxWidth="1.7976931348623157E308"
                            onAction="#btnAdicionarClick"
                            styleClass="action-button, primary-button"
                            text="＋ Adicionar" />

                    <Button
                            fx:id="btnLimpar"
                            HBox.hgrow="ALWAYS"
                            maxWidth="1.7976931348623157E308"
                            onAction="#btnLimparClick"
                            styleClass="action-button, secondary-button"
                            text="↻ Limpar" />

                </HBox>

            </VBox>

            <!-- TABELA -->
            <VBox
                    HBox.hgrow="ALWAYS"
                    prefWidth="550.0"
                    spacing="14.0"
                    styleClass="card">

                <HBox
                        alignment="CENTER_LEFT">

                    <Label
                            styleClass="section-title"
                            text="Pokémon cadastrados" />

                    <Region
                            HBox.hgrow="ALWAYS" />

                    <Label
                            fx:id="lblContador"
                            styleClass="count-badge"
                            text="0 Pokémon" />

                </HBox>

                <TextField
                        fx:id="txtPesquisar"
                        promptText="🔎 Pesquisar por nome, tipo, número ou geração..."
                        styleClass="search-field" />

                <TableView
                        fx:id="tblPokemon"
                        VBox.vgrow="ALWAYS"
                        prefHeight="360.0">

                    <columns>

                        <TableColumn
                                fx:id="colNum"
                                prefWidth="85.0"
                                sortable="true"
                                text="Número" />

                        <TableColumn
                                fx:id="colNome"
                                prefWidth="155.0"
                                sortable="true"
                                text="Nome" />

                        <TableColumn
                                fx:id="colTipo"
                                prefWidth="175.0"
                                sortable="true"
                                text="Tipo" />

                        <TableColumn
                                fx:id="colGeracao"
                                prefWidth="95.0"
                                sortable="true"
                                text="Geração" />

                    </columns>

                </TableView>

                <HBox
                        alignment="CENTER_RIGHT"
                        spacing="10.0">

                    <Button
                            fx:id="btnEditar"
                            disable="true"
                            onAction="#btnEditarClick"
                            prefWidth="125.0"
                            styleClass="action-button, edit-button"
                            text="✎ Editar" />

                    <Button
                            fx:id="btnExcluir"
                            disable="true"
                            onAction="#btnExcluirClick"
                            prefWidth="125.0"
                            styleClass="action-button, delete-button"
                            text="✕ Excluir" />

                </HBox>

            </VBox>

        </HBox>

    </center>

    <!-- MENSAGENS -->
    <bottom>

        <HBox
                alignment="CENTER_LEFT"
                styleClass="status-bar">

            <Label
                    fx:id="lblMensagem"
                    styleClass="status-message, status-info"
                    text="Sistema pronto." />

        </HBox>

    </bottom>

</BorderPane>